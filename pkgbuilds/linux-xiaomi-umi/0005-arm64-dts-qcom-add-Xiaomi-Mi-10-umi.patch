+/*
+ * 蓝牙：QCA6390 走 uart6（geniqup@9c0000 / qupv3_id_1 下的 serial@998000）。
+ *
+ * ★ 这段以前写在 sm8250-xiaomi-umi.dts 里，但真正编进镜像的是
+ *   sm8250-xiaomi-umi-wifi.dts，它只 include 了 common.dtsi —— 于是
+ *   uart6 一直是 disabled、bluetooth 节点根本不存在，BT 当然起不来。
+ *   现在放到 common.dtsi，所有变体都能用。
+ *
+ * ★★ 还必须给 uart6 一个 serial alias：qcom_geni_serial 用
+ *   of_alias_get_id(np, "serial") 取端口号，取不到就 -ENODEV
+ *   （dmesg: "qcom_geni_serial 998000.serial: Invalid line -19"）。
+ *   更麻烦的是：这个没绑上的 uart6 会让 qnoc/interconnect 的
+ *   sync_state() 一直 pending，把它当 consumer 的 **pcie0 就被拖住不 probe**
+ *   —— 表现就是“蓝牙没起来，WiFi 也没了”。
+ *
+ * 固件在 linux-firmware 里：qca/hpbtfw21.tlv（patchram）+ qca/hpnv21.bin。
+ */
+/ {
+	aliases {
+		serial1 = &uart6;
+	};
+};
+
+&uart6 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,qca6390-bt";
+		/*
+		 * 这六条 supply 不是给驱动供电用的（hci_qca 对 QCA6390 的
+		 * num_vregs = 0），而是让 pwrseq-qcom-wcn 的
+		 * pwrseq_qcom_wcn_match() 认下这个 consumer：它要求 consumer 的
+		 * vddaon-supply 解析到「父节点就是 PMU」的那个 regulator。
+		 * 认下来之后 hci_qca 才会 pwrseq_power_on() -> 拉高 BT_EN(gpio21)。
+		 */
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddbtcmx-supply = <&vreg_pmu_btcmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
+		max-speed = <3200000>;
+		/*
+		 * hci_qca 会把这个名字前面再加一次 "qca/"，依次试 "<name>" 和
+		 * "<name 去掉扩展名>.bin"；另外 patchram 的名字是它按 ROM 版本自己拼的
+		 * （本机 ROM 0x200 -> qca/htbtfw20.tlv）。
+		 * 所以这里只写 NVM 的**文件名**，最终落到 qca/htnv20.bin
+		 * （写 "qca/hpbtfw21.tlv" 会变成 qca/qca/... 那种双前缀路径）。
+		 */
+		firmware-name = "htnv20.bin";
+
+		/*
+		 * ★★ 必须给 BD_ADDR，否则蓝牙永远「未配置」。
+		 *
+		 * 现象：固件下载成功、QCA setup 走完，hci0 也出现了，但
+		 *     btmgmt info      -> "Index list with 0 items"
+		 *     bluetoothctl list -> 空
+		 *     /sys/kernel/debug/bluetooth/hci0/ 里只有 ibs
+		 *
+		 * 原因链（插桩确认，见 docs/BLUETOOTH.md §6）：
+		 *   btqca.c 的 qca_check_bdaddr() 读控制器地址，发现它和 NVM 里的
+		 *   地址一样（本机读回来 ad:5a:00:00:00:00，打印是 00:00:00:00:5a:ad），
+		 *   就置 HCI_QUIRK_USE_BDADDR_PROPERTY —— 等于宣布「这颗芯片没有
+		 *   出厂地址，等设备树/用户态给」。hci_sync.c 的 hci_dev_setup_sync()
+		 *   随后把它标成 HCI_UNCONFIGURED，只跑 hci_unconf_init_sync()，
+		 *   mgmt 只发 Unconfigured Index Added，bluetoothctl 就看不到它。
+		 *
+		 * 给了 local-bd-address 之后：hci_dev_get_bd_addr_from_property()
+		 * 读出地址 -> hdev->set_bdaddr()（qca_set_bdaddr）写进控制器 ->
+		 * invalid_bdaddr 变 false -> 正常配置、mgmt 发 Index Added。
+		 *
+		 * 字节序：DT 里是**小端**（LSB 在前）——
+		 *     [cc 3d 78 9d d7 a6] == a6:d7:9d:78:3d:cc
+		 * 取值跟着 WiFi 的固定 MAC（a6:d7:9d:78:3d:cb）顺延一位。
+		 */
+		local-bd-address = [cc 3d 78 9d d7 a6];
+	};
+};
+
+/* ---------------------------------------------------------------- Type-C / 充电 */
+/*
+ * PM8150B 自带的 typec 控制器（TCPM）+ USB-C connector。
+ *
+ * 厂商 DT 里还挂了 displayport altmode、以及 fsa4480（SBU/音频 switch），
+ * 那些依赖 DSI/USB PHY 的 crossbar 对接，等 DP over USB-C 真正做的时候再加；
+ * 现在先把「插拔 / 角色 / PD 协商」这条最常用的路走通。
+ */
+&pm8150b_typec {
+	vdd-pdphy-supply = <&vreg_l2a_3p1>;
+	status = "okay";
+
+	connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+		op-sink-microwatt = <10000000>;
+		/*
+		 * 现在只做 sink（充电 + PD 协商）：我们的 dwc3 是 peripheral-only，
+		 * 没有 role switch 可切；dual-role / DP altmode 需要先接上
+		 * usb_1_qmpphy 和 fsa4480，等那条线做完再打开。
+		 */
+		power-role = "sink";
+		/*
+		 * 必须显式写 data-role = "device"。
+		 * TCPM 在 sink attach 时用 tcpm_data_role_for_sink()：
+		 *   typec_caps.data == TYPEC_PORT_DFP ? TYPEC_HOST : TYPEC_DEVICE
+		 * connector 没声明 data-role 时 caps.data 退化成 DFP，
+		 * data_role 就被报成 host —— 于是 PD 一直不协商、只能拿到 SDP 5V/500mA，
+		 * 插 PD 充电器还会 cc/vbus 反复 attach-detach（表现为充电断连循环）。
+		 * 我们的 dwc3 是 peripheral-only（dr_mode = "peripheral"），本来就该是 device。
+		 */
+		data-role = "device";
+		self-powered;
+		vbus-supply = <&pm8150b_vbus>;
+
+		sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+			     PDO_VAR(5000, 12000, 5000)>;
+	};
+};
+
+&pm8150b_vbus {
+	regulator-min-microamp = <500000>;
+	regulator-max-microamp = <3000000>;
+	status = "okay";
+};
