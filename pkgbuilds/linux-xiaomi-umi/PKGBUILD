# Close-to-mainline 6.12 LTS kernel for the Xiaomi Mi 10 (umi).
#
# Patches 0001-0014 and the config are the ones of the Nura port
# (miercolesvd/mi10-port, pmaports/device/testing/linux-xiaomi-umi), which in
# turn come from the colorgarden/umi-mainline bring-up. 0015 makes the USB-C
# port dual role so hubs, docks and keyboards work.
#
# The package installs the gzip kernel, the device tree and the modules under
# /usr/lib/modules/<release>/. umi-device turns them into the Android boot
# image and writes it to the boot partition (umi-update-boot).

pkgname=linux-xiaomi-umi
_kver=6.12.94
pkgver=$_kver
pkgrel=1
pkgdesc="Close-to-mainline LTS kernel for the Xiaomi Mi 10 (umi)"
arch=(aarch64)
url="https://github.com/miercolesvd/mi10-arch-linux"
license=(GPL-2.0-only)
depends=(kmod)
makedepends=(bc bison clang cpio flex libelf lld llvm openssl pahole perl python tar xz zstd)
options=(!strip !debug !lto)
_srcname=linux-$_kver
source=(
  "https://cdn.kernel.org/pub/linux/kernel/v${_kver%%.*}.x/$_srcname.tar.xz"
  config
  0001-dmaengine-qcom-gpi-add-sm8250-EE-offset-variants.patch
  0002-drm-panel-add-Xiaomi-Mi-10-umi-DSC-command-mode-AMOL.patch
  0003-Input-touchscreen-add-vendor-derived-ST-FTS-driver-f.patch
  0004-power-supply-add-Qualcomm-PM8150B-fuel-gauge-SMB5-ch.patch
  0005-arm64-dts-qcom-add-Xiaomi-Mi-10-umi.patch
  0006-arm64-dts-qcom-umi-send-the-panel-s-90-Hz-on-sequenc.patch
  0007-ASoC-cs35l41-don-t-fail-power-up-when-PUP-PDN-status.patch
  0008-ASoC-qcom-sm8250-set-up-both-CS35L41-amps-on-Xiaomi-.patch
  0009-arm64-dts-qcom-umi-load-ADSP-firmware-through-msm-fi.patch
  0010-soc-qcom-pd-mapper-cpufreq-dt-platdev-match-SM8250-r.patch
  0011-arm64-dts-qcom-umi-enable-PCIe-RC2-for-the-SDX55-mod.patch
  0012-bus-mhi-host-serve-a-flashless-SDX55M-s-Sahara-and-E.patch
  0013-bus-mhi-host-pci_generic-max_msi_vectors-parameter.patch
  0014-regulator-add-the-Xiaomi-Mi-10-SDX55M-power-on-seque.patch
  0015-arm64-dts-qcom-umi-make-the-USB-C-port-dual-role.patch
)
