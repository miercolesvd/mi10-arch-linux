_make() {
  make ARCH=arm64 LLVM=1 KBUILD_BUILD_VERSION="$pkgrel" "$@"
}

prepare() {
  cd "$_srcname"

  local p
  for p in "$srcdir"/0*.patch; do
    echo "==> Applying ${p##*/}"
    patch -Np1 -i "$p"
  done

  cp "$srcdir/config" .config
  # The config was resolved with another clang version; settle the
  # compiler-dependent symbols without prompting.
  _make olddefconfig
  _make -s kernelrelease > version
  echo "==> Kernel release: $(<version)"
}

build() {
  cd "$_srcname"
  unset LDFLAGS
  _make Image.gz modules qcom/sm8250-xiaomi-umi.dtb
}

package() {
  cd "$_srcname"
  local kver modulesdir
  kver=$(<version)
  modulesdir="$pkgdir/usr/lib/modules/$kver"

  echo "==> Installing modules for $kver"
  # depmod runs from kmod's pacman hook on the target
  _make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install
  rm -f "$modulesdir"/build "$modulesdir"/source

  echo "==> Installing Image.gz and the device tree"
  install -Dm644 arch/arm64/boot/Image.gz "$modulesdir/Image.gz"
  install -Dm644 arch/arm64/boot/dts/qcom/sm8250-xiaomi-umi.dtb \
    "$modulesdir/dtbs/qcom/sm8250-xiaomi-umi.dtb"
}
