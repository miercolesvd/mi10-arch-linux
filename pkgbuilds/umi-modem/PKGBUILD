prepare() {
  # linux-msm/tqftpserv at eb4b9a04 (BSD-3-Clause) with the -v option: this
  # modem finds no TFTP server published as version 1 only. Built without
  # xz/zstd: the modem's files are plain.
  mkdir -p tqftpserv
  local f
  for f in tqftpserv.c translate.c translate.h list.h xz-decompress.h zstd-decompress.h; do
    cp "tqftpserv-$f" "tqftpserv/$f"
  done
  patch -d tqftpserv -p1 < tqftpserv-version.diff
}

build() {
  gcc $CFLAGS -Wall -Wextra -pthread -o mi10-mdm mi10-mdm.c $LDFLAGS
  gcc $CFLAGS -Wall -Wextra -o mi10-qmi mi10-qmi.c $LDFLAGS
  gcc $CFLAGS -Wall -o tqftpserv/tqftpserv \
    tqftpserv/tqftpserv.c tqftpserv/translate.c $LDFLAGS -lqrtr
}

package() {
  install -Dm755 -t "$pkgdir/usr/bin" mi10-mdm mi10-qmi umi-modem-data
  install -Dm755 -t "$pkgdir/usr/libexec/umi-modem" \
    umi-modem-start umi-modem-data-up tqftpserv/tqftpserv
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" \
    umi-modem.service umi-tqftpserv.service umi-modem-data.service
  install -Dm644 umi-modem.conf "$pkgdir/usr/lib/modprobe.d/umi-modem.conf"
  install -Dm644 tqftpserv-LICENSE "$pkgdir/usr/share/licenses/$pkgname/tqftpserv-LICENSE"
}
