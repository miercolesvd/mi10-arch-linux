# Boots the Xiaomi Mi 10's SDX55M modem on mainline and starts mobile data
# (fallback route when Wi-Fi is off). Same sources as umi-modem in the Nura
# port; see docs/modem.md there for how it works.
#
# Paths stay as in the port: the scripts call /usr/sbin/..., which is
# /usr/bin on Arch, and keep their helpers in /usr/libexec/umi-modem.

pkgname=umi-modem
pkgver=0.1
pkgrel=1
pkgdesc="Xiaomi Mi 10: boot the SDX55M modem (Sahara image server, EFS syncs kept in RAM)"
arch=(aarch64)
url="https://github.com/miercolesvd/mi10-arch-linux"
license=(GPL-2.0-only BSD-3-Clause)
depends=(iproute2 kmod msm-firmware-loader qrtr)
source=(
  mi10-mdm.c
  mi10-qmi.c
  umi-modem-start
  umi-modem-data
  umi-modem-data-up
  umi-modem.service
  umi-modem.conf
  umi-tqftpserv.service
  umi-modem-data.service
  tqftpserv-version.diff
  tqftpserv-tqftpserv.c
  tqftpserv-translate.c
  tqftpserv-translate.h
  tqftpserv-list.h
  tqftpserv-xz-decompress.h
  tqftpserv-zstd-decompress.h
  tqftpserv-LICENSE
)
sha256sums=(
